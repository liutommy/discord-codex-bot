<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: replace com.example with your own reverse-DNS prefix (label and file name) and
     __HOME__ with the absolute home directory; launchd expands neither ~ nor $HOME. The image
     service's instance of dcb-llm-relay.py: same script, its own config (the argument), workers
     and log, next to com.example.dcb-llm-relay.plist. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.dcb-image-relay</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>__HOME__/.local/bin/dcb-llm-relay.py</string>
        <string>__HOME__/.config/dcb-llm-relay/image.config</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/dcb-image-relay.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/dcb-image-relay.launchd.log</string>
</dict>
</plist>
