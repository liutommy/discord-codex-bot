<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: replace com.example with your own reverse-DNS prefix (label and file name),
     __HOME__ with the absolute home directory, __MLX_LM_SERVER__ with the absolute path of the
     mlx_lm.server executable, __PORT__ with the upstream port in dcb-llm-relay's config and
     __MODEL_DIR__ with the model directory. launchd expands neither ~ nor $HOME. Bound to
     127.0.0.1: only the relay on this Mac reaches it. mlx_lm.server loads the model a request
     names; HF_HUB_OFFLINE keeps such a request from downloading one. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.local-llm</string>
    <key>ProgramArguments</key>
    <array>
        <string>__MLX_LM_SERVER__</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>__PORT__</string>
        <string>--model</string>
        <string>__MODEL_DIR__</string>
        <string>--decode-concurrency</string>
        <string>2</string>
        <string>--prompt-concurrency</string>
        <string>2</string>
        <string>--max-tokens</string>
        <string>8192</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HF_HUB_OFFLINE</key>
        <string>1</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/local-llm.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/local-llm.log</string>
</dict>
</plist>
