# Discord Developer Portal values. Never commit the real token.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=

# Comma-separated Discord server IDs. Start with only the test server.
ALLOWED_GUILD_IDS=111111111111111111

# Optional comma-separated channel IDs. Set the test channel during development.
# Clear this after rollout if every channel in both allowed servers may use the bot.
ALLOWED_CHANNEL_IDS=975467992370520074

# Slash command prefix: /<prefix>, /<prefix>-status, -reset, -remember, -forget, -memory, -style.
COMMAND_PREFIX=codex

# Operator-controlled Codex settings. Discord users cannot override these.
CODEX_MODEL=gpt-5.6-luna
# Default reasoning effort; /codex lets members pick low, medium, high, xhigh or max per request.
CODEX_REASONING_EFFORT=medium
CODEX_TIMEOUT_SECONDS=600
MAX_PROMPT_CHARS=6000
MAX_RESPONSE_CHARS=12000
MAX_QUEUED_JOBS=10

# Optional /codex image attachment. Files live in a per-request directory under ATTACHMENT_DIR
# (container tmpfs), are deleted when the request ends, and leftovers are swept periodically.
MAX_ATTACHMENT_BYTES=8000000
MAX_ATTACHMENTS=4
ATTACHMENT_SWEEP_MINUTES=10

# Follow-up questions from the same member in the same channel resume the same Codex thread for
# this many minutes; replying to a Bot answer always resumes that thread. /codex-reset clears it.
THREAD_TTL_MINUTES=60

# Threads that can no longer be resumed (TTL passed, persona/style rebuilt, /reset or new:True)
# are distilled once into the member's personal memory, checked on this cadence.
HARVEST_INTERVAL_MINUTES=10

# Social tracking. Disabled until provider credentials are configured. A new watch starts in
# shadow mode and posts its AI decisions for review; /<prefix>-track live:<id> enables alerts.
# Classification uses the operator's Codex subscription with isolated memory/history and the
# fixed operator model. It defers when either subscription window has less than the configured
# remaining percentage, and is also capped per UTC day.
TRACKING_ENABLED=false
TRACKING_INTERVAL_MINUTES=15
TRACKING_MIN_REMAINING_PERCENT=50
TRACKING_AI_MAX_CALLS_PER_DAY=30
TRACKING_MAX_PER_USER=10
TRACKING_REASONING_EFFORT=high
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Container and volume name prefix (volume becomes <name>_codex_home). Change before first start;
# renaming later points Compose at a new, empty volume.
BOT_CONTAINER_NAME=tommy_test

# Image build pins. Update deliberately after validation.
CODEX_VERSION=0.153.4
UV_VERSION=0.10.0

# Two-tier long-term memory (Claude Code auto-memory shape): per scope an index MEMORY.md that is
# injected into every prompt (first MEMORY_INDEX_MAX_LINES or MEMORY_INDEX_MAX_BYTES, whichever
# comes first) plus topic files read on demand. Older index lines move to MEMORY-archive.md.
MEMORY_INDEX_MAX_LINES=200
MEMORY_INDEX_MAX_BYTES=25000
MEMORY_USER_MAX_BYTES=50000000
MEMORY_GUILD_MAX_BYTES=200000000
MEMORY_READ_MAX_LINES=2000
MEMORY_READ_MAX_BYTES=50000
MEMORY_SEARCH_MAX_MATCHES=50
MEMORY_SEARCH_CONTEXT_LINES=3
MEMORY_RECALL_ROUNDS=10

# Operator default output style; see config/output-style.md (baked into the image).
OUTPUT_STYLE_FILE=/opt/discord-codex/output-style.md

# Daily memory consolidation (dedupe / newest-wins / merge fragments) for every scope of every
# guild, run by the Bot through one `codex exec --output-schema` per batch. Runs at
# CONSOLIDATE_HOUR local time in CONSOLIDATE_TIMEZONE, only when the 5-hour quota still has at
# least CONSOLIDATE_MIN_REMAINING_PERCENT left (a minimal probe turn refreshes the reading first).
CONSOLIDATE_HOUR=2
CONSOLIDATE_TIMEZONE=Asia/Taipei
CONSOLIDATE_MIN_REMAINING_PERCENT=50
CONSOLIDATE_MAX_INPUT_BYTES=100000

# Operator-managed permanent memory: permanent/MEMORY.md (+ permanent/topics/*.md) in the repo
# directory, gitignored, baked into the image. Injected whole; never evicted; no slash command.
PERMANENT_MEMORY_DIR=/opt/discord-codex/permanent

# Persona layer: persona/*.md (gitignored) is appended to /workspace/AGENTS.md at build time.
# Members with a personal style are served from CODEX_WORKSPACE_PLAIN (rules only, no persona).
CODEX_WORKSPACE_PLAIN=/workspace-plain

# Antigravity CLI (agy) second backend. Members pick it per user with /<prefix>-model; the default
# stays Codex. Its Google login lives in the <name>_agy_home volume (docker exec -it <name> agy).
AGY_HOME=/home/node
AGY_PROBE_MODEL=gemini-3.8-flash-low

# OpenRouter backend (third backend, free models only). Empty = the provider is not offered.
# Conversations are Bot-kept transcripts (OpenRouter is stateless), replayed within a budget.
OPENROUTER_API_KEY=
OPENROUTER_DIR=/var/lib/codex/openrouter
OPENROUTER_CATALOG_TTL_SECONDS=3600
OPENROUTER_HISTORY_CHARS=60000

# OrcaRouter (OpenAI-compatible; only its -free tier is offered). Empty = not offered.
# Its free tier needs a GitHub account linked in the OrcaRouter profile; limits are unpublished
# and surface as 429 free_rate_limited — the Bot tells the member to retry later or switch.
ORCAROUTER_API_KEY=

# Operator alerts by DM: a backend failing ALERT_AFTER_FAILURES times in a row, or a login/key
# that stopped working (alerted at once), then a recovery note. ALERT_USER_ID empty = the Discord
# application's owner. Cooldown stops a burst from becoming a flood; the login watch is hourly.
ALERT_USER_ID=
ALERT_AFTER_FAILURES=3
ALERT_COOLDOWN_MINUTES=30
ALERT_LOGIN_CHECK_MINUTES=60

# Web search tool (<web query/> from the model, every backend). Order: the keyed API when
# SEARCH_API + SEARCH_API_KEY are set (brave), then the self-hosted SearXNG in compose.
SEARCH_URL=http://searxng:8080
SEARCH_API=
SEARCH_API_KEY=
SEARCH_MAX_RESULTS=5

# The 記住 button shows this guild custom emoji when the guild has one; otherwise 👍.
REMEMBER_EMOJI_NAME=114514

# Daily backup (BACKUP_HOUR, consolidation timezone) of memories, router transcripts, thread
# map, reminders into BACKUP_DIR (bind-mounted ./backups on the host); older than
# BACKUP_KEEP_DAYS are pruned. Empty BACKUP_DIR = off. Manual: python -m discord_codex_bot.backup
BACKUP_DIR=/backups
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14

# The Bot's own log, written to LOG_DIR (bind-mounted ./logs on the host) as bot.log and
# rotated at local midnight into bot.log.YYYY-MM-DD, keeping LOG_KEEP_DAYS files. Needed
# because `docker logs` only holds the current container and a rebuild discards it.
# Empty LOG_DIR = stderr only.
# Leaguepedia (Fandom) bot password: Special:BotPasswords on the wiki. Anonymous
# Cargo queries are throttled within a couple of calls; a logged-in one is not.
# Empty = the Bot queries anonymously and takes the rate limit.
LEAGUEPEDIA_USER=
LEAGUEPEDIA_PASSWORD=

LOG_DIR=/logs
LOG_KEEP_DAYS=14

# Sandbox sidecar: the model runs <run lang="python|sh"> snippets there (no network, hard
# limits, one at a time). Empty SANDBOX_URL disables the tool.
SANDBOX_URL=http://sandbox:8070
SANDBOX_TIMEOUT_SECONDS=30

# Registered data APIs (config/apis.json in the image): name, https base, fixed headers
# (${ENV} in a value is read from the environment), and a usage note for the model.
APIS_FILE=/opt/discord-codex/apis.json
APIS_MAX_CHARS=60000

# Release announcements: announce/latest.md (gitignored, baked into the image) is posted once to
# each channel listed here when its content changes. Empty = announcements off (default).
# Nothing is posted unless ANNOUNCE_APPROVED equals the file's content hash (the Bot logs the hash
# it sees at startup); approving one version never approves the next.
ANNOUNCE_CHANNEL_IDS=
ANNOUNCE_APPROVED=

# Bot-side link fetching, shared by both backends: URLs in a member's message are fetched
# (public http/https only — LAN, loopback and reserved addresses are refused) into the prompt,
# and the model may ask for more pages with <fetch url="…"/>. Sizes are per URL.
LINK_MAX_URLS=3
LINK_MAX_BYTES=2000000
LINK_MAX_CHARS=20000
LINK_TIMEOUT_SECONDS=15
# Chromium fallback for blocked or client-rendered pages (and <fetch render="1"/>): page load
# budget in seconds and the tallest full-page screenshot (px) attached for the model to look at.
LINK_RENDER_TIMEOUT_SECONDS=40
LINK_SCREENSHOT_MAX_HEIGHT=4000
# Discord attaches link previews (embeds) a moment after a message; wait this long once for them.
LINK_PREVIEW_WAIT_SECONDS=2

# Gemini free tier as a video-understanding tool (X clips inline, YouTube by URL/captions).
# Empty = disabled. No billing must be attached to this key; free-tier content trains Google.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_SECONDS=180
GEMINI_VIDEO_INLINE_MAX_BYTES=12000000
GEMINI_VIDEO_MAX_CHARS=4000
VIDEO_INTERIM_AFTER_SECONDS=8
