# Discord Developer Portal values. Never commit the real token.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=

# Comma-separated Discord server IDs. Start with only the test server.
ALLOWED_GUILD_IDS=111111111111111111

# Optional comma-separated channel IDs. Set the test channel during development.
# Clear this after rollout if every channel in both allowed servers may use the bot.
ALLOWED_CHANNEL_IDS=222222222222222222

# Operator-controlled Codex settings. Discord users cannot override these.
CODEX_MODEL=gpt-5.6-luna
# Default reasoning effort; /codex lets members pick low, medium, high, xhigh or max per request.
CODEX_REASONING_EFFORT=medium
CODEX_TIMEOUT_SECONDS=600
MAX_PROMPT_CHARS=6000
MAX_RESPONSE_CHARS=12000
MAX_QUEUED_JOBS=10

# Optional /codex image attachment. Files live in a per-request directory under ATTACHMENT_DIR
# (container tmpfs), are deleted when the request ends, and leftovers are swept periodically.
MAX_ATTACHMENT_BYTES=8000000
MAX_ATTACHMENTS=4
ATTACHMENT_SWEEP_MINUTES=10

# Image build pins. Update deliberately after validation.
CODEX_VERSION=0.153.4
UV_VERSION=0.10.0
