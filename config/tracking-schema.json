{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisions"],
  "properties": {
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "external_item_id",
          "notify",
          "confidence",
          "category",
          "reason",
          "matched_topics",
          "message"
        ],
        "properties": {
          "external_item_id": {"type": "string", "minLength": 1},
          "notify": {"type": "boolean"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "category": {"type": "string"},
          "reason": {"type": "string"},
          "matched_topics": {
            "type": "array",
            "items": {"type": "string"}
          },
          "message": {"type": "string", "maxLength": 600}
        }
      }
    }
  }
}
