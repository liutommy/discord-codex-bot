.env
.git
.github
.uv-cache
.venv
# At any depth: a bare name matches only the top level, and the host's bytecode (from
# whatever ran there last, unmerged branches included) was baked into the image.
**/__pycache__
**/*.pyc
.pytest_cache
.ruff_cache
tests

# Host-local files never COPY'd into an image. Sent as build context they are still read (a
# non-root build fails on state/, mode 700) and kept in the builder cache: sign-ins and DBs.
state
backups
logs
compose.override.yaml
.hold
**/*.age
