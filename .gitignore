.env
.uv-cache/
.venv
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

permanent/*
!permanent/README.md
persona/*
!persona/README.md
!persona/AGENTS.example.md
# The operator's own default style, like the persona, stays out of a repo meant to be published;
# config/output-style.example.md is what a clone copies and edits.
config/output-style.md
backups/
logs/
# Host-local: the bind-mounted homes (DB, memory, sign-ins), the override that mounts them, and
# the "keep the stack down" flag.
state/
compose.override.yaml
.hold
# Host-local copies of the deploy/orbstack examples (real addresses and mail commands); only the
# *.example files are tracked. Installed copies live outside the checkout, these guard a copy made
# in place.
deploy/orbstack/dcb.default
deploy/orbstack/mac/dcb-wake.config
deploy/orbstack/mac/dcb-llm-relay.config
deploy/orbstack/mac/targets
deploy/orbstack/mac/*.plist
!deploy/orbstack/mac/com.example.*.plist
